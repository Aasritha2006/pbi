{
  "version": "1.0.0.0",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "discourageImplicitMeasures": true,
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "['Fact_Sales', 'Dim_Product', 'Dim_Location', 'Dim_Customer', 'Dim_Salesperson', 'Dim_Date', 'Dim_MonthAllocation', 'Fact_Budget_Monthly', 'Date_Ranges']"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "tables": [
      {
        "name": "Fact_Sales",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "string",
            "sourceColumn": "Order ID",
            "summarizeBy": "none"
          },
          {
            "name": "Product ID",
            "dataType": "string",
            "sourceColumn": "Product ID",
            "summarizeBy": "none"
          },
          {
            "name": "Location ID",
            "dataType": "string",
            "sourceColumn": "Location ID",
            "summarizeBy": "none"
          },
          {
            "name": "Sales Person ID",
            "dataType": "string",
            "sourceColumn": "Sales Person ID",
            "summarizeBy": "none"
          },
          {
            "name": "Customer ID",
            "dataType": "string",
            "sourceColumn": "Customer ID",
            "summarizeBy": "none"
          },
          {
            "name": "Order Date",
            "dataType": "dateTime",
            "sourceColumn": "Order Date",
            "summarizeBy": "none",
            "formatString": "dd-mmm-yyyy"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "Price",
            "dataType": "int64",
            "sourceColumn": "Price",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Revenue",
            "dataType": "double",
            "expression": "[Quantity] * [Price]",
            "formatString": "#,##0.00",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Cost",
            "dataType": "double",
            "expression": "[Quantity] * RELATED(Dim_Product[Cost])",
            "formatString": "#,##0.00",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Profit",
            "dataType": "double",
            "expression": "[Revenue] - [Cost]",
            "formatString": "#,##0.00",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Revenue Per Unit",
            "dataType": "double",
            "expression": "DIVIDE([Revenue], [Quantity])",
            "formatString": "#,##0.00",
            "summarizeBy": "average"
          },
          {
            "type": "calculated",
            "name": "Profit Per Unit",
            "dataType": "double",
            "expression": "DIVIDE([Profit], [Quantity])",
            "formatString": "#,##0.00",
            "summarizeBy": "average"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Sales_Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), type table [#\"Order ID\"=nullable string, #\"Product ID\"=nullable string, #\"Location ID\"=nullable string, #\"Sales Person ID\"=nullable string, #\"Customer ID\"=nullable string, #\"Order Date\"=nullable dateTime, Quantity=nullable int64, Price=nullable int64])\nin\n    Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Fact_Sales[Revenue])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(Fact_Sales[Order ID])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Quantity",
            "expression": "SUM(Fact_Sales[Quantity])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Customers",
            "expression": "DISTINCTCOUNT(Fact_Sales[Customer ID])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Products",
            "expression": "DISTINCTCOUNT(Fact_Sales[Product ID])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total States",
            "expression": "DISTINCTCOUNT(Dim_Location[State])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Locations",
            "expression": "DISTINCTCOUNT(Dim_Location[Location ID])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Population",
            "expression": "SUM(Dim_Location[Population])",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Total Sales], [Total Orders])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Average Selling Price",
            "expression": "DIVIDE([Total Sales], [Total Quantity])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Cost",
            "expression": "SUM(Fact_Sales[Cost])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Total Profit",
            "expression": "[Total Sales] - [Total Cost]",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE([Total Profit], [Total Sales])",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Revenue Per Unit",
            "expression": "DIVIDE([Total Sales], [Total Quantity])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Profit Per Unit",
            "expression": "DIVIDE([Total Profit], [Total Quantity])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Current Year Sales",
            "expression": "CALCULATE([Total Sales], Dim_Date[Year] = MAX(Dim_Date[Year]))",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Previous Year Sales",
            "expression": "CALCULATE([Total Sales], SAMEPERIODLASTYEAR(Dim_Date[Date]))",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "YoY Sales Growth",
            "expression": "[Current Year Sales] - [Previous Year Sales]",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "YoY Growth %",
            "expression": "DIVIDE([YoY Sales Growth], [Previous Year Sales])",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "MTD Sales",
            "expression": "TOTALMTD([Total Sales], Dim_Date[Date])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "YTD Sales",
            "expression": "TOTALYTD([Total Sales], Dim_Date[Date])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Previous Year YTD Sales",
            "expression": "CALCULATE([YTD Sales], SAMEPERIODLASTYEAR(Dim_Date[Date]))",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Sales Previous Month",
            "expression": "CALCULATE([Total Sales], DATEADD(Dim_Date[Date], -1, MONTH))",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Running Sales",
            "expression": "CALCULATE([Total Sales], FILTER(ALL(Dim_Date[Date]), Dim_Date[Date] <= MAX(Dim_Date[Date])))",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "3 Month Moving Average",
            "expression": "AVERAGEX(DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -3, MONTH), [Total Sales])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Budget",
            "expression": "SUM(Fact_Budget_Monthly[Monthly Budget])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Actual Sales",
            "expression": "[Total Sales]",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Budget Variance",
            "expression": "[Actual Sales] - [Budget]",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Budget Variance %",
            "expression": "DIVIDE([Budget Variance], [Budget])",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Budget Achievement %",
            "expression": "DIVIDE([Actual Sales], [Budget])",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Product Rank",
            "expression": "RANKX(ALL(Dim_Product[Product Name]), [Total Sales], , DESC, DENSE)",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Customer Rank",
            "expression": "RANKX(ALL(Dim_Customer[Customer Name]), [Total Sales], , DESC, DENSE)",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Salesperson Rank",
            "expression": "RANKX(ALL(Dim_Salesperson[Salesperson Name]), [Total Sales], , DESC, DENSE)",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Location Rank",
            "expression": "RANKX(ALL(Dim_Location[Name]), [Total Sales], , DESC, DENSE)",
            "formatString": "#,##0",
            "detailRowsDefinition": {}
          },
          {
            "name": "Top 10 Product Sales",
            "expression": "IF([Product Rank] <= 10, [Total Sales])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Top 10 Customer Sales",
            "expression": "IF([Customer Rank] <= 10, [Total Sales])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Top 10 Salesperson Sales",
            "expression": "IF([Salesperson Rank] <= 10, [Total Sales])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Top 10 Location Sales",
            "expression": "IF([Location Rank] <= 10, [Total Sales])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          },
          {
            "name": "Product Contribution %",
            "expression": "DIVIDE([Total Sales], CALCULATE([Total Sales], ALL(Dim_Product)))",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Customer Contribution %",
            "expression": "DIVIDE([Total Sales], CALCULATE([Total Sales], ALL(Dim_Customer)))",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Salesperson Contribution %",
            "expression": "DIVIDE([Total Sales], CALCULATE([Total Sales], ALL(Dim_Salesperson)))",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Selected Sales %",
            "expression": "DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED(Dim_Product)))",
            "formatString": "0.0%",
            "detailRowsDefinition": {}
          },
          {
            "name": "Average Product Sales",
            "expression": "AVERAGEX(VALUES(Dim_Product[Product ID]), [Total Sales])",
            "formatString": "#,##0.00",
            "detailRowsDefinition": {}
          }
        ]
      },
